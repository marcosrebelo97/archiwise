## Váriaveis de ambiente para o docker-compose, para facilitar a configuração do ambiente.
## Se estiver usando o docker-compose so e necessário alterar as variáveis de porta do backend e frontend.
PORT_BACKEND=4000 ## Porta do backend
PORT_FRONTEND=3000 ## Porta do frontend

PORT_PYTHON_WHOSH=5001
PORT_PYTHON_CAT=5000
PORT_GOTENBERG=4001
PORT_PHPMYADMIN=8080

## Configuração do banco de dados
MYSQL_PORT=3328
MYSQL_DATABASE=archiwise
MYSQL_USER=api_main
MYSQL_PASSWORD=troque_esta_senha
MYSQL_ROOT_PASSWORD=troque_esta_senha

REDIS_PORT=6379
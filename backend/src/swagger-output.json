    "/v1/docs/": {
      "get": {
        "tags": [
          "Document"
        ],
        "description": "Retorna todos os documentos do usuário autenticado. Possui filtros opcionais: categoryId, startDate e endDate. Caso startDate e endDate sejam informados, filtra por um período; se apenas startDate for informado, filtra pelo dia exato.",
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "type": "string"
          },
          {
            "name": "types",
            "in": "query",
            "type": "string"
          },
          {
            "name": "isFavorite",
            "in": "query",
            "type": "string"
          },
          {
            "name": "categoryId",
            "in": "query",
            "description": "ID da categoria para filtrar os documentos",
            "required": false,
            "type": "string"
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "Data de início para filtro (Formato: YYYY-MM-DD). Se endDate for informada, define o início do período; caso contrário, filtra o dia exato.",
            "required": false,
            "type": "string",
            "format": "date"
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "Data de fim para filtro de período (Formato: YYYY-MM-DD). Opcional, caso seja informada junto com startDate define o intervalo.",
            "required": false,
            "type": "string",
            "format": "date"
          },
          {
            "name": "isDeleted",
            "in": "query",
            "description": "Flag que indica se o Documento está ou não na lixeira.",
            "required": false,
            "type": "boolean"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de documentos do usuário.",
            "schema": {
              "$ref": "#/definitions/Documents"
            }
          },
          "401": {
            "description": "Não autorizado. Usuário não autenticado.",
            "schema": {
              "$ref": "#/definitions/Error401"
            }
          }
        }
      },
      "post": {
        "tags": [
          "Document"
        ],
        "description": "Cria um novo documento para o usuário autenticado.",
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "file",
            "in": "formData",
            "description": "Arquivo do documento que será enviado",
            "required": true,
            "type": "file"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Campos necessários para criar o documento",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateDocumentSchema"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "201": {
            "description": "Documento criado com sucesso.",
            "schema": {
              "$ref": "#/definitions/Document"
            }
          },
          "401": {
            "description": "Não autorizado. Usuário não autenticado.",
            "schema": {
              "$ref": "#/definitions/Error401"
            }
          },
          "422": {
            "description": "Erro de validação de schema ou arquivo não encontrado.",
            "schema": {
              "$ref": "#/definitions/Error422"
            }
          }
        }
      }
    },

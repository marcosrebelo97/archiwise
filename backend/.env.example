NODE_ENV=development
SESSION_SECRET=secret
HOST=localhost ## Variavel usada no swagger

## Se estiver usando o docker-compose nao e necessário alterar as variáveis abaixo
DATABASE_URL=mysql://root:troque_esta_senha@mysql:3306/archiwise
REDIS_URL=redis://redis:6379
GOTENBERG_ENDPOINT=http://gotenberg:3000
PYTHON_ENDPOINT=http://indexer_api:5000/api/archiwise

## Sicronize com as portas corretas
FRONTEND_ENDPOINT=http://localhost:3000
PORT=4000

## Google Cloud Storage (armazenamento dos arquivos)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GCS_BUCKET=archiwise

## SMTP para o e-mail de recuperação de senha
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
